[gd_resource type="Resource" script_class="StoryDatabase" format=3 uid="uid://bmb4exiuncptx"]

[ext_resource type="Script" uid="uid://c5vrivnqx3087" path="res://data/story/core/story-database.gd" id="1"]
[ext_resource type="Script" uid="uid://dmag04w4sgyp3" path="res://data/story/core/story-arc-data.gd" id="2"]
[ext_resource type="Script" uid="uid://cgui3it25dto7" path="res://data/story/core/story-chapter-data.gd" id="3"]
[ext_resource type="Script" uid="uid://b34icgatiuxum" path="res://data/story/core/story-stage-data.gd" id="4"]
[ext_resource type="Script" uid="uid://dl4wtju884vg8" path="res://data/story/core/story-action.gd" id="4_0jria"]
[ext_resource type="Script" uid="uid://cxhtdsbyj0w2e" path="res://data/story/core/story-flag-definition.gd" id="5"]
[ext_resource type="Script" uid="uid://b4irnk17m6do5" path="res://data/story/core/story-transition-data.gd" id="5_fnk1q"]
