[resource]
script = ExtResource("2_t3ral")
subject_name = "Optics & Light Behaviour"
subject_icon = ExtResource("3_t3ral")
subject_id = "PHY-001-OP"
subject_archetype = "Physical Sciences"
field_of_study = "The study of light propagation, reflection, refraction, diffraction, and the behaviour of electromagnetic waves in the visible spectrum."
theoretical_foundation = "Snell's Law of Refraction: light bends when crossing medium boundaries at an angle proportional to the refractive index difference between mediums. A caster who models this can reposition along non-linear angles — harder to anticipate than a straight dash.

Diffraction: waves bend around obstacles and spread into shadow regions. The caster can exploit this to make their mana signature harder to target-lock.

Converging Lens Behaviour: parallel rays focus to a single point, maximising energy density at that point. The theoretical basis for high-damage narrow beam spells — all available mana converged to one irresistible point."
casters_notes = "Optics rewards patience. Every spell in this subject has a precision requirement — the caster who rushes the visualisation gets a fizzle, not a miss. Light does not forgive imprecise geometry. Know your angles before you move."
magis_archetype = "Ilmiah"
difficulty_level = 3
prerequisites = Array[String](["PHY-001-WP"])
contained_spells = Array[ExtResource("1_gs7yy")]([ExtResource("2_cmc12"), ExtResource("3_5payj"), ExtResource("4_gt4by")])
metadata/_custom_type_script = "uid://b6vkafnios50y"
