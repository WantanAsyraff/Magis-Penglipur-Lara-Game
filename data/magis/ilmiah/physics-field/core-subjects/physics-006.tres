[resource]
script = ExtResource("subject")
academic_fields = [ExtResource("field")]
subject_icon = ExtResource("icon")
subject_name = "Electromagnetism"
subject_id = "PHY-006"
subject_archetype = "Physical Sciences"
magis_archetype = "Ilmiah"
magis_comprehension = "Intermediate"
difficulty_level = 2
prerequisites = Array[String](["PHY-003"])
contained_spells = [ExtResource("s0"), ExtResource("s1"), ExtResource("s2"), ExtResource("s3")]
theoretical_foundation = "Electric fields exert forces on charge; discharges follow available conductive paths. Conducting enclosures redistribute charge; shielding depends on geometry and frequency. Magnetic response depends on material and charge motion. Changing magnetic flux induces an electromotive force."
field_of_study = "Electromagnetism"
casters_notes = "Learn: Static Arc, Faraday Cage, Magnetic Tether, Induction Grid. Mana supplies fictional effects; capability tags restrict environmental manipulation."
