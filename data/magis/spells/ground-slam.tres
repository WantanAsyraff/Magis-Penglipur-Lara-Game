script = ExtResource("1_xatdl")
spell_name = "Ground Slam"
spell_id = "ground_slam"
theory_desc = "\"By converting downward force into a concentrated shock front through rapid mana compression, the caster drives a seismic pulse into the ground. The resulting displacement propagates outward in a short-radius burst, destabilizing nearby targets and delivering blunt kinetic trauma.\""
