spell_name = "Thermal Siphon"
spell_id = "PHY-TH-001"
spell_icon = ExtResource("2_8iocq")
spell_flavour_text = "Cold doesn't attack warmth. It simply receives it."
theory_desc = "Second Law of Thermodynamics. Caster creates a mana-temperature differential between themselves and the target, drawing thermal energy out of the target's mana field. Suppresses target mana regen. ~30% mana return to caster over DoT duration. Not fire damage — cold drain.
Synergy: Third Law Impact weakens aura resistance first → boosts mana return to ~50%."
