[resource]
script = ExtResource("1_tfmy1")
spell_name = "Viscous Drag"
spell_id = "PHY-FM-002"
spell_icon = ExtResource("2_f8sew")
spell_flavour_text = "The faster you run, the heavier the air becomes. He made sure of that."
theory_desc = "Viscous drag — resistance force on objects moving through a fluid, proportional to velocity. Caster coats the target's mana field in high-viscosity mana fluid. The faster the target moves the higher the drag force — fast casters and movement-heavy fighters are punished most severely. Stationary targets feel minimal effect. DoT is the sustained drag taxation on their mana."
