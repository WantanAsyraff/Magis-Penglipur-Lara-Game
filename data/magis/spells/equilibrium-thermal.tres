[resource]
script = ExtResource("1_iqdi6")
spell_name = "Thermal Equilibrium"
spell_id = "PHY-TH-003"
spell_icon = ExtResource("2_pqliw")
spell_flavour_text = "Two systems. One temperature. He gives freely what he has too much of."
theory_desc = "Thermal equilibrium — energy transfers between systems until both reach the same state. Caster equalises their mana with an ally's, redistributing from the higher-reserve party to the lower. Not a heal — a share. If the caster has less mana than the target the transfer reverses. Useful when one party is near overdraw.
Synergy: Follow with Thermal Siphon on an enemy — restock a depleted ally and immediately drain the opponent in the same rotation."
magis_archetype = "Ilmiah"
spell_incantation = Array[String](["down", "right", "left", "up", "left"])
upfront_cost = 25
