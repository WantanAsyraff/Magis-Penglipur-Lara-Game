[ext_resource type="Script" path="res://data/story/conditions/story-cutscene-condition.gd" id="cutscene_condition"]
[ext_resource type="Script" path="res://data/story/conditions/story-flag-condition.gd" id="flag_condition"]
[ext_resource type="Resource" path="res://data/story/kampung-intro.tres" id="kampung_intro"]
[ext_resource type="Resource" path="res://data/story/school-entrance.tres" id="school_intro"]
[ext_resource type="Script" uid="uid://b26dsyq8wptr" path="res://data/story/core/story-choice-data.gd" id="6_mbvmn"]

[sub_resource type="Resource" id="flag1"]
script = ExtResource("5")
flag_id = &"story.prologue.left_house"
display_name = "Left House"

[sub_resource type="Resource" id="flag2"]
script = ExtResource("5")
flag_id = &"story.prologue.reached_school"
display_name = "Reached School"

[sub_resource type="Resource" id="flag3"]
script = ExtResource("5")
flag_id = &"story.prologue.spm_completed"
display_name = "Spm Completed"

[sub_resource type="Resource" id="flag4"]
script = ExtResource("5")
flag_id = &"story.prologue.practical_demonstrated"
display_name = "Kinetic Chill demonstrated"

[sub_resource type="Resource" id="intro_condition"]
script = ExtResource("cutscene_condition")
sequence_reference = ExtResource("kampung_intro")

[sub_resource type="Resource" id="school_condition"]
script = ExtResource("cutscene_condition")
sequence_reference = ExtResource("school_intro")

[sub_resource type="Resource" id="practical_condition"]
script = ExtResource("flag_condition")
flag_definition = SubResource("flag4")

[sub_resource type="Resource" id="wake_to_leave"]
script = ExtResource("5_fnk1q")
transition_id = &"prologue.wake_up_to_leave_house"
display_name = "Kampung introduction complete"
target_stage_id = &"prologue.leave_house"
conditions = Array[StoryCondition]([SubResource("intro_condition")])

[sub_resource type="Resource" id="leave_to_school"]
script = ExtResource("5_fnk1q")
transition_id = &"prologue.leave_house_to_reach_school"
display_name = "Reached school entrance"
target_stage_id = &"prologue.reach_school"
required_event_type = 5
required_event_target = "prologue.school_entrance"

[sub_resource type="Resource" id="school_to_practical"]
script = ExtResource("5_fnk1q")
transition_id = &"prologue.reach_school_to_spm_practical"
display_name = "School introduction complete"
target_stage_id = &"prologue.spm_practical"
conditions = Array[StoryCondition]([SubResource("school_condition")])

[sub_resource type="Resource" id="practical_to_after"]
script = ExtResource("5_fnk1q")
transition_id = &"prologue.spm_practical_to_after_exam"
display_name = "Practical completed"
target_stage_id = &"prologue.after_exam"
conditions = Array[StoryCondition]([SubResource("practical_condition")])
required_event_type = 11
required_event_target = "story.prologue.spm_completed"

[sub_resource type="Resource" id="stage1"]
script = ExtResource("4")
stage_id = &"prologue.wake_up"
display_name = "Wake Up"
objective_hint = "Wake at Yan’s house"
transitions = Array[ExtResource("5_fnk1q")]([SubResource("wake_to_leave")])

[sub_resource type="Resource" id="stage2"]
script = ExtResource("4")
stage_id = &"prologue.leave_house"
display_name = "Leave House"
objective_hint = "Leave for the final paper"
transitions = Array[ExtResource("5_fnk1q")]([SubResource("leave_to_school")])

[sub_resource type="Resource" id="stage3"]
script = ExtResource("4")
stage_id = &"prologue.reach_school"
display_name = "Reach School"
objective_hint = "Arrive at school"
transitions = Array[ExtResource("5_fnk1q")]([SubResource("school_to_practical")])

[sub_resource type="Resource" id="stage4"]
script = ExtResource("4")
stage_id = &"prologue.spm_practical"
display_name = "SPM Practical"
objective_hint = "Use Kinetic Chill on the Magis receiver, then reach the exam exit"
transitions = Array[ExtResource("5_fnk1q")]([SubResource("practical_to_after")])

[sub_resource type="Resource" id="stage5"]
script = ExtResource("4")
stage_id = &"prologue.after_exam"
display_name = "After Exam"
objective_hint = "Continue after the final paper"

[sub_resource type="Resource" id="chapter"]
script = ExtResource("3")
chapter_id = &"prologue"
chapter_name = "Prologue"
stages = Array[ExtResource("4")]([SubResource("stage1"), SubResource("stage2"), SubResource("stage3"), SubResource("stage4"), SubResource("stage5")])
initial_stage_id = &"prologue.wake_up"

[sub_resource type="Resource" id="arc"]
script = ExtResource("2")
arc_id = &"main"
display_name = "Main Story"
chapters = Array[ExtResource("3")]([SubResource("chapter")])
initial_chapter_id = &"prologue"

[resource]
script = ExtResource("1")
arcs = Array[ExtResource("2")]([SubResource("arc")])
flags = Array[ExtResource("5")]([SubResource("flag1"), SubResource("flag2"), SubResource("flag3"), SubResource("flag4")])
