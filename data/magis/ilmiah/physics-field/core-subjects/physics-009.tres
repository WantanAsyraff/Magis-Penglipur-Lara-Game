[resource]
script = ExtResource("subject")
academic_fields = [ExtResource("field")]
subject_icon = ExtResource("icon")
subject_name = "Material and Structural Physics"
subject_id = "PHY-009"
subject_archetype = "Physical Sciences"
magis_archetype = "Ilmiah"
magis_comprehension = "Advanced"
difficulty_level = 3
prerequisites = Array[String](["PHY-004"])
contained_spells = [ExtResource("s0"), ExtResource("s1"), ExtResource("s2"), ExtResource("s3")]
theoretical_foundation = "Elastic deformation can store energy and return part of an impact. Brittle materials fracture with little plastic deformation. Structures transmit loads through their geometry and constituent materials. Repeated driving can accumulate response when losses are sufficiently small."
field_of_study = "Material and Structural Physics"
casters_notes = "Learn: Elastic Barrier, Brittle Fracture, Structural Fabrication, Resonance Threshold. Mana supplies fictional effects; capability tags restrict environmental manipulation."
