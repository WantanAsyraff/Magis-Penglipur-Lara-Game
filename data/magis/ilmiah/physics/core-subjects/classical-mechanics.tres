[resource]
script = ExtResource("2_dqeqo")
subject_name = "Classical Mechanics"
subject_icon = ExtResource("3_6tpjg")
subject_id = "PHY-001-CM"
subject_archetype = "Physical Sciences"
field_of_study = "Newton's Third Law: every action force has an equal and opposite reaction force. Force is not generated — it is redirected. A caster who understands this casts efficiently; one who doesn't wastes mana on force that goes nowhere.

Newton's Second Law (F = ma): force scales with mass and acceleration. Calibrating spell intensity is a calculation, not a feeling.

Impulse-Momentum Theorem (J = Δp = FΔt): force applied over time changes momentum. Short sharp bursts and sustained pressure are both valid — they demand different mana strategies."
theoretical_foundation = "Newton's Third Law: every action force has an equal and opposite reaction force. Force is not generated — it is redirected. A caster who understands this casts efficiently; one who doesn't wastes mana on force that goes nowhere."
casters_notes = "Most students fail their first force spell not from weak mana but from a weak mental model. They picture 'hitting something hard' rather than the actual force vector. Precision of imagination mirrors precision of theory. If you understand why something moves, you can control how it moves."
magis_archetype = "Ilmiah"
difficulty_level = 2
contained_spells = Array[ExtResource("1_q2ydl")]([ExtResource("3_he1la"), ExtResource("2_mgtlf"), ExtResource("4_k4enl")])
