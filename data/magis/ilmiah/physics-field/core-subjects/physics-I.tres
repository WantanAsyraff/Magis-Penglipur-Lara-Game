[resource]
academic_fields = [ExtResource("field_physics")]
script = ExtResource("2_74ogc")
subject_name = "Physics I"
subject_icon = ExtResource("3_74ogc")
subject_id = "PHY-001"
difficulty_level = 1
subject_archetype = "Physical Sciences"
field_of_study = "Introduction to the physical world: how objects move, interact, and transfer energy through force and momentum. The student learns to read cause and effect in physical systems."
theoretical_foundation = "Newton's Laws of Motion establish that force equals mass times acceleration (F=ma). Every physical interaction has a measurable, predictable consequence. Mana directed with calculated intent multiplies impact — carelessly applied mana yields diminishing returns. Momentum transfer describes how kinetic energy moves between objects on contact. Vibration theory introduces the idea that all matter oscillates, applying an external frequency to a target destabilises its internal state."
casters_notes = "Your first spells are blunt by design. Force asks you to calculate acceleration at the point of contact. Strike asks you to sustain that momentum across a distance. Tremor asks you to introduce instability into a target rather than destroy it outright. Learn to feel the difference between hitting and transferring."
magis_archetype = "Ilmiah"
contained_spells = Array[ExtResource("1_4mgb3")]([ExtResource("2_62rvh"), ExtResource("3_uffm3"), ExtResource("4_e4m48")])
metadata/_custom_type_script = "uid://b6vkafnios50y"
