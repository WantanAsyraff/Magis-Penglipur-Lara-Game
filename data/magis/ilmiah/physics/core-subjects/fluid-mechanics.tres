[resource]
script = ExtResource("2_7l7xv")
subject_name = "Fluid Mechanics"
subject_icon = ExtResource("3_7l7xv")
subject_id = "PHY-001-FM"
subject_archetype = "Physical Sciences"
field_of_study = "The study of fluids at rest and in motion. Covers pressure, Pascal's Law, Bernoulli's principle, viscosity, drag, and fluid dynamics."
theoretical_foundation = "Pascal's Law: pressure applied to a confined fluid transmits equally in all directions. A pressurised mana shell detonates inward — the force originates inside the target's aura boundary, bypassing surface defences.

Viscous Drag: resistance force on objects moving through a fluid is proportional to velocity. The faster a target moves, the heavier the drag taxation. High-mobility fighters are punished most severely."
casters_notes = "Fluid spells are about exploiting confinement. Pressure in an open space dissipates. Pressure in a closed one compounds. Always think about whether your target has room to move — if they don't, these spells hit harder than anything else in the Novice tier."
magis_archetype = "Ilmiah"
magis_comprehension = "Intermediate"
difficulty_level = 3
prerequisites = Array[String](["PHY-001-TH"])
contained_spells = Array[ExtResource("1_2vg6p")]([ExtResource("2_0lw36"), ExtResource("3_24qk7")])
metadata/_custom_type_script = "uid://b6vkafnios50y"
