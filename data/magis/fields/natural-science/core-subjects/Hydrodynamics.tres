script = ExtResource("2_ghmjl")
subject_name = "Hydrodynamics"
subject_id = "hydrodynamics_101"
subject_archetype = "Physical Sciences"
subject_description = "The study of fluids in motion, examining pressure gradients, flow velocity, turbulence, and energy transfer in liquid systems. Core principles include Bernoulli's equation, laminar vs. turbulent flow, and Pascal's law. Casters learn to manipulate water currents, control pressure differentials, and harness the immense force of compressed liquids for both offensive strikes and environmental manipulation."
