script = ExtResource("1_leur6")
spell_name = "Entropy Accelerate"
spell_id = "PHY-TH-002"
spell_icon = ExtResource("2_xudhr")
spell_flavour_text = "All things fall apart eventually. He simply has a schedule."
theory_desc = "All things fall apart eventually. He simply has a schedule.\"
theory_desc = \"\"\"Entropy — universal tendency toward disorder and energy dispersal. Saturates an area: active spells decay faster, mana regen suppressed zone-wide, structured defence values degrade. Affects the caster equally — positioning and aura management are mandatory. Standing inside your own entropy field without aura discipline is the most common beginner mistake.
Synergy: Dampening Field on self while Entropy Accelerate is active — caster is shielded from entropic bleed-back while opponents cannot sustain defences."
