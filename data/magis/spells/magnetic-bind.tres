spell_name = "Magnetic Bind"
spell_id = "PHY-EM-002"
spell_icon = ExtResource("2_wgurv")
spell_flavour_text = "Opposite poles attract. He decided which one you are."
theory_desc = "Electromagnetism — magnetic fields exert forces on moving charges. Caster magnetises the target's mana field relative to a fixed point, either pulling them toward a location or locking them via equal opposing forces from multiple poles. Initial damage from the magnetisation pulse; stun duration is the hold.
Synergy: Magnetic Bind holds → Focal Point cannot be dodged → guaranteed damage window."
