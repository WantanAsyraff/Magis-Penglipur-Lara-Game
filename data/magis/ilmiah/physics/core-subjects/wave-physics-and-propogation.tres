[resource]
script = ExtResource("2_qtbsr")
subject_name = "Wave Physics & Propagation"
subject_icon = ExtResource("3_qtbsr")
subject_id = "PHY-001-WP"
subject_archetype = "Physical Sciences"
field_of_study = "The study of oscillation, wave propagation, interference, resonance, and energy transfer through mediums. Covers mechanical waves, sound, frequency, and amplitude."
theoretical_foundation = "Resonance: when a system is driven at its natural frequency, amplitude grows dramatically with little added energy. Identifying the resonant frequency of a mana structure is more efficient than brute force.

Constructive & Destructive Interference: two waves amplify or cancel depending on phase alignment. This is the theoretical basis for spell synergies — layering in phase amplifies, misaligned spells waste mana.

Wave Energy ∝ Amplitude²: doubling amplitude quadruples energy. Modulating mana output in wave-shaped bursts rather than flat sustained pushes is fundamentally more efficient."
casters_notes = "Wave spells are where theoretical students pull ahead of raw-talent casters. There is no shortcut for resonance — you either know the physics or you waste mana hammering at something that could have been undone with a whisper."
magis_archetype = "Ilmiah"
difficulty_level = 2
prerequisites = Array[String](["PHY-001-CM"])
contained_spells = Array[ExtResource("1_rxvqx")]([ExtResource("2_2472a"), ExtResource("3_7aubg"), ExtResource("4_xabhh")])
metadata/_custom_type_script = "uid://b6vkafnios50y"
