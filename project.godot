; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Magis Penglipur Lara"
config/tags=PackedStringArray("flagship", "rpg")
run/main_scene="res://scenes/ui/menus/intro-menus/main-menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Player_Global_Data="*res://autoloads/player-data.gd"
Spell_Library="*res://autoloads/spell-library.gd"
Player_Manager="*res://autoloads/player-manager.gd"
Network_Manager="*res://autoloads/network-manager.gd"
SceneManager="*uid://j20v4cg7v8m1"
Scene_Registry="*res://autoloads/scene-registry.gd"
Dialogic="*uid://ds2q0uclmolvu"
Noray="*uid://gu4bv4tgms3x"
PacketHandshake="*uid://tt3j25a05n7c"
World_Manifest="*res://autoloads/world-manifest.gd"
QuestManager="*res://autoloads/quest-manager.gd"
Inventory_Manager="*res://autoloads/inventory-manager.gd"
LyricsManager="*res://system/lyrics/lyrics-manager.gd"
LyricsOverlay="*res://system/lyrics/lyrics-overlay-ui.tscn"
Crafting_Context="*res://autoloads/crafting-context.gd"

[dialogic]

directories/dch_directory={
"Pak Guard": "res://dialogue/characters/Pak Guard.dch",
"ariff": "res://dialogue/characters/ariff.dch",
"hasan": "res://dialogue/characters/hasan.dch",
"player": "res://dialogue/characters/player.dch",
"sara": "res://dialogue/characters/sara.dch",
"yan": "res://dialogue/characters/yan.dch",
"yunira": "res://dialogue/characters/yunira.dch"
}
directories/dtl_directory={
"QuestDialogue": "res://dialogue/quest/QuestDialogue.dtl",
"QuestDialogue-FLAC": "res://dialogue/quest/QuestDialogue-FLAC.dtl",
"after-final-paper": "res://dialogue/story-mode/prologue/after-final-paper.dtl",
"kampung-scene": "res://dialogue/story-mode/prologue/kampung-scene.dtl",
"scene-1": "res://dialogue/story-mode/akademi-bintang-utama/chapter-1/scene-1.dtl",
"spm-school-entrance": "res://dialogue/story-mode/prologue/spm-school-entrance.dtl",
"story-select-npc": "res://dialogue/overworld/story-select-npc.dtl",
"students-and-errands": "res://dialogue/tutorials/students-and-errands.dtl"
}
layout/style_directory={
"": "res://dialogue/styles/main-style.tres",
"main-style": "res://dialogue/styles/main-style.tres"
}
glossary/default_case_sensitive=false
variables={
"CurrentPortrait": "Ur not supposed to see this",
"QuestText": "Ur not supposed to see this"
}
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.02
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
Noray="*res://addons/netfox.noray/noray.gd"
PacketHandshake="*res://addons/netfox.noray/packet-handshake.gd"
Network_Manager="*res://autoloads/network-manager.gd"
layout/style_list=["res://dialogue/styles/main-style.tres"]
layout/default_style="res://dialogue/styles/main-style.tres"
glossary/glossary_files=["uid://b72mepwie50f3"]
translation/enabled=false
translation/original_locale="en"
translation/file_mode=1
translation/translation_folder=""
translation/save_mode=0
translation/add_separator=false
history/simple_history_enabled=false
history/full_history_enabled=true
text/autocolor_names=true
glossary/default_color=Color(0.921875, 0.86008054, 0.47246093, 1)

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/netfox.internals/plugin.cfg", "res://addons/netfox.noray/plugin.cfg", "res://addons/scene_manager/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "pink",
"res://assets/audio/": "orange",
"res://autoloads/": "red",
"res://components/": "yellow",
"res://data/": "teal",
"res://data/Resources/": "green",
"res://dialogue/": "purple",
"res://scenes/": "orange",
"res://scenes/ui/": "blue",
"res://scenes/worlds/": "red",
"res://system/": "green",
"res://tools/": "pink"
}

[global_group]

player="The player, duh. For object detection and owies"

