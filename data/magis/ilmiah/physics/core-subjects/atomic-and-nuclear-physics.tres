[resource]
script = ExtResource("2_8vfke")
subject_name = "Atomic & Nuclear Physics"
subject_icon = ExtResource("3_8vfke")
subject_id = "PHY-001-NP"
subject_archetype = "Physical Sciences"
field_of_study = "The study of atomic structure, nuclear forces, radioactive decay, fission, fusion, and the binding energy of atomic nuclei."
theoretical_foundation = "Nuclear Fission: a heavy nucleus splits into smaller fragments, releasing the binding energy that held it together. Targeting the densest mana concentration point — the equivalent of a nucleus — and fracturing it releases that energy as explosive damage with radioactive fallout.

Strong Nuclear Force: the most powerful fundamental force, operating at extremely short range, binding protons and neutrons against electromagnetic repulsion. Internalised as a mana aura it creates structural resistance that cannot be cancelled by interference-based defences."
casters_notes = "A caster who cannot clearly visualise atomic structure will misfire on Fission Strike — targeting the wrong density point reduces damage to near zero. This is not a subject for students who skipped theoretical fundamentals. The mana cost reflects how much the body has to understand, not just how hard it has to work."
magis_archetype = "Ilmiah"
magis_comprehension = "Advanced"
difficulty_level = 4
prerequisites = Array[String](["PHY-001-OP"])
contained_spells = Array[ExtResource("1_l81c0")]([ExtResource("2_55s8u"), ExtResource("3_tdbfr")])
metadata/_custom_type_script = "uid://b6vkafnios50y"
