2d_render/layer_4="EnemyProjectiles"
2d_render/layer_5="Environment"
2d_render/layer_6="UserInterface"
2d_render/layer_7="NPCs"
2d_render/layer_8="Drops"
2d_physics/layer_1="Player"
2d_physics/layer_2="Enemies"
2d_physics/layer_3="PlayerProjectiles"
