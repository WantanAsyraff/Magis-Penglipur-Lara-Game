script = ExtResource("1_hrlih")
spell_name = "Arc Discharge"
spell_id = "PHY-EM-001"
spell_icon = ExtResource("2_hud7w")
spell_flavour_text = "Charge always finds its way home. He just picks the destination."
theory_desc = "Electrical discharge — charge differential between two points creates a conductive arc. Caster builds mana charge polarisation between their conductor and the target then releases. Targets with disrupted mana auras take increased damage — the arc follows the path of least resistance, and a weakened aura is exactly that.
Synergy: Thermal Siphon suppresses mana regen (weakened aura) → Arc Discharge damage scales up significantly."
