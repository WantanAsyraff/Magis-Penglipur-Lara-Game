[resource]
script = ExtResource("subject")
academic_fields = [ExtResource("field")]
subject_icon = ExtResource("icon")
subject_name = "Acoustics and Harmonic Physics"
subject_id = "PHY-010"
subject_archetype = "Physical Sciences"
magis_archetype = "Ilmiah"
magis_comprehension = "Advanced"
difficulty_level = 3
prerequisites = Array[String](["PHY-002"])
contained_spells = [ExtResource("s0"), ExtResource("s1"), ExtResource("s2")]
theoretical_foundation = "Sound is a propagating pressure disturbance in a medium. Oscillations can be controlled by feedback; biological healing here is entirely magical. Opposite-phase coherent waves can cancel displacement locally, without erasing energy."
field_of_study = "Acoustics and Harmonic Physics"
casters_notes = "Learn: Sonic Pulse, Harmonic Stabilization, Phase Cancellation. Mana supplies fictional effects; capability tags restrict environmental manipulation."
