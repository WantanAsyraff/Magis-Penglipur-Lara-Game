[resource]
script = ExtResource("subject")
academic_fields = [ExtResource("field")]
subject_icon = ExtResource("icon")
subject_name = "Thermodynamics"
subject_id = "PHY-005"
subject_archetype = "Physical Sciences"
magis_archetype = "Ilmiah"
magis_comprehension = "Intermediate"
difficulty_level = 2
prerequisites = Array[String](["PHY-001"])
contained_spells = [ExtResource("s0"), ExtResource("s1"), ExtResource("s2"), ExtResource("s3")]
theoretical_foundation = "Temperature relates to microscopic energy distributions, not bulk movement. Heat flows because of temperature differences; mana supplies heating energy. Entropy production accompanies irreversible processes; entropy is not a substance. A heat engine converts some supplied heat to work; efficiency is bounded."
field_of_study = "Thermodynamics"
casters_notes = "Learn: Kinetic Chill, Thermal Bloom, Entropy Leak, Heat Engine. Mana supplies fictional effects; capability tags restrict environmental manipulation."
