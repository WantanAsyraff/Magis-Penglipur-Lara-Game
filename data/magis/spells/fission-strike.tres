script = ExtResource("1_2moy8")
spell_name = "Fission Strike"
spell_id = "PHY-NP-001"
spell_icon = ExtResource("2_ciogl")
spell_colour = Color(1, 0.92, 0.6, 1)
spell_flavour_text = "The energy was always there. Held together by force. He simply asked it to stop."
theory_desc = "Nuclear fission — a heavy nucleus splits into smaller fragments releasing its binding energy. Caster targets the densest mana concentration point of the opponent's structure and fractures it. Binding energy releases as explosion; residual mana shards continue as DoT radiation fallout. High cost and cast time reflect theoretical complexity — a caster who cannot visualise atomic structure misfires entirely.
Synergy: Entropy Accelerate weakens mana structural integrity zone-wide first — the nuclear core becomes easier to locate and fracture under entropy conditions."
