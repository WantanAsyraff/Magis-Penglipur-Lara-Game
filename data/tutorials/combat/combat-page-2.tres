[resource]
script = ExtResource("1_ngd1k")
page_title = "BASICS OF SPELLCASTING"
page_desc = "As a spellcaster, your chance of winning combat depends on your spell comprehension and incantations.
Spells are activated by combo incantations.

O - Enable/Disable Spellcasting Mode

I - Spellcast up
J - Spellcast left
K - Spellcast down
L - Spellcast right

P - Cancel spellcasting string

Aiming your spells:
W - Aim up 
A - Aim left
S - Aim down
D - Aim right
You can also aim diagonally by combining your aiming keys.
F - Force stop in spellcasting (Useful when aiming on edges)

The stronger the spell, the more combos it requires."
page_image = ExtResource("1_ptdsm")
metadata/_custom_type_script = "uid://bgh41gug308cv"
