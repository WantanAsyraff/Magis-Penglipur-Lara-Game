[sub_resource type="Resource" id="stage1"]
script = ExtResource("4")
stage_id = &"prologue.wake_up"
display_name = "Wake Up"
objective_hint = "Wake at Yan’s house"

[sub_resource type="Resource" id="stage2"]
script = ExtResource("4")
stage_id = &"prologue.leave_house"
display_name = "Leave House"
objective_hint = "Leave for the final paper"

[sub_resource type="Resource" id="stage3"]
script = ExtResource("4")
stage_id = &"prologue.reach_school"
display_name = "Reach School"
objective_hint = "Arrive at school"

[sub_resource type="Resource" id="stage4"]
script = ExtResource("4")
stage_id = &"prologue.spm_practical"
display_name = "SPM Practical"
objective_hint = "Complete the practical"

[sub_resource type="Resource" id="stage5"]
script = ExtResource("4")
stage_id = &"prologue.after_exam"
display_name = "After Exam"
objective_hint = "Continue after the final paper"

[sub_resource type="Resource" id="chapter"]
script = ExtResource("3")
chapter_id = &"prologue"
chapter_name = "Prologue"
stages = Array[ExtResource("4")]([SubResource("stage1"), SubResource("stage2"), SubResource("stage3"), SubResource("stage4"), SubResource("stage5")])
initial_stage_id = &"prologue.wake_up"

[sub_resource type="Resource" id="arc"]
script = ExtResource("2")
arc_id = &"main"
display_name = "Main Story"
chapters = Array[ExtResource("3")]([SubResource("chapter")])
initial_chapter_id = &"prologue"

[sub_resource type="Resource" id="flag1"]
script = ExtResource("5")
flag_id = &"story.prologue.left_house"
display_name = "Left House"

[sub_resource type="Resource" id="flag2"]
script = ExtResource("5")
flag_id = &"story.prologue.reached_school"
display_name = "Reached School"

[sub_resource type="Resource" id="flag3"]
script = ExtResource("5")
flag_id = &"story.prologue.spm_completed"
display_name = "Spm Completed"

[resource]
script = ExtResource("1")
arcs = Array[ExtResource("2")]([SubResource("arc")])
flags = Array[ExtResource("5")]([SubResource("flag1"), SubResource("flag2"), SubResource("flag3")])
