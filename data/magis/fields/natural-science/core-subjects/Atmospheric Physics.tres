script = ExtResource("2_thxrb")
subject_name = "Atmospheric Physics"
subject_id = "atmospheric_physics_101"
subject_archetype = "Physical Sciences"
subject_description = "The examination of atmospheric phenomena including air pressure systems, electrical discharge, cloud formation, and weather dynamics. Students study charge separation in storm systems, ionization pathways, electromagnetic theory, and thermodynamic processes in gases. This knowledge enables casters to command lightning strikes, manipulate air currents, and induce localized atmospheric changes through precise understanding of meteorological forces."
