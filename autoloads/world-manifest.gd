extends Node

var _registry: Node
const WORLDS_PATH = "res://data/worlds/hubs/"

func _ready() -> void:
	_registry = get_node("/root/Scene_Registry")
	if not _registry:
		push_error("WorldManifest: Could not find SceneRegistry autoload.")
		return

	var paths := _scan_dir(WORLDS_PATH)

	if paths.is_empty():
		push_warning("WorldManifest: DirAccess scan failed (likely exported build), using baked paths.")
		paths = _get_baked_paths()

	_registry.register_paths(paths)
	print("─── WorldManifest: registered %d scenes ───" % paths.size())

	if OS.is_debug_build():
		for p in paths:
			print("  • %s" % p)
		_validate_scene_ids()

func _scan_dir(path: String) -> PackedStringArray:
	var result: PackedStringArray = []
	var dir := DirAccess.open(path)
	if not dir:
		return result
	dir.list_dir_begin()
	var entry := dir.get_next()
	while entry != "":
		if dir.current_is_dir():
			result.append_array(_scan_dir(path + entry + "/"))
		elif entry.ends_with(".tres") and not entry.begins_with("_"):
			result.append(path + entry)
		entry = dir.get_next()
	dir.list_dir_end()
	return result

func _get_baked_paths() -> PackedStringArray:
	# Load the baked manifest generated by tools/bake_world_manifest.gd
	var manifest := load("res://autoloads/world-manifest-paths.gd")
	if not manifest:
		push_error("WorldManifest: No baked manifest found! Run tools/bake_world_manifest.gd first.")
		return []
	return manifest.BAKED_PATHS

func _validate_scene_ids() -> void:
	print("─── WorldManifest: validating scene_ids ───")
	var issues := 0
	for id in _registry.get_all_scene_ids():
		if id.is_empty():
			push_warning("  ⚠ empty scene_id found")
			issues += 1
		elif id != id.to_lower():
			push_warning("  ⚠ '%s' has uppercase letters" % id)
			issues += 1
		elif "-" in id:
			push_warning("  ⚠ '%s' has hyphens — use underscores" % id)
			issues += 1
		elif " " in id:
			push_warning("  ⚠ '%s' has spaces — use underscores" % id)
			issues += 1
	if issues == 0:
		print("  ✓ all %d scene_ids look clean" % _registry.get_all_scene_ids().size())
	else:
		print("  %d issue(s) found" % issues)
