script = ExtResource("1_cx6ag")
spell_name = "Inertial Anchor"
spell_id = "PHY-CM-003"
spell_icon = ExtResource("2_8so48")
spell_colour = Color(0.7, 0.8, 0.95, 1)
spell_flavour_text = "The universe prefers stillness. He simply agrees on your behalf."
theory_desc = "Newton's First Law — inertia. The caster saturates the target's mana field with resistance opposing any change in motion state. A moving target is slowed dramatically; a stationary target is rooted. No damage — pure motion denial. Duration scales with how still the target already is at time of impact.
Synergy: Cast on a stunned target (Third Law Impact) for maximum anchor duration."
