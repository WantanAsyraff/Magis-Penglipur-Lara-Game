"Al-Zalam": {
"alternatives": ["Magis Al-Zalam"],
"case_sensitive": true,
"name": "Al-Zalam",
"text": "Derived from the word \"Dark\", Al-Zalam feeds on strong emotions, creating manifestations of the mind of the caster.",
"title": "The Dark Magic"
},
"Magis": {
"case_sensitive": true,
"color": Color(0.48742676, 0.9453125, 0.9238491, 1),
"name": "Magis",
"text": "Magis, the core foundation of all mythical and beyond.",
"title": "This world's magic."
},
"Magis Al-Zalam": "Al-Zalam"
}
