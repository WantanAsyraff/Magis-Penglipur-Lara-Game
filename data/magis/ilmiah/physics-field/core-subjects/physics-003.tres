[resource]
script = ExtResource("subject")
academic_fields = [ExtResource("field")]
subject_icon = ExtResource("icon")
subject_name = "Kinematics and Momentum"
subject_id = "PHY-003"
subject_archetype = "Physical Sciences"
magis_archetype = "Ilmiah"
magis_comprehension = "Intermediate"
difficulty_level = 2
prerequisites = Array[String](["PHY-001"])
contained_spells = [ExtResource("s0"), ExtResource("s1"), ExtResource("s2"), ExtResource("s3")]
theoretical_foundation = "Velocity is a vector; reversing it requires an impulse supplied here by mana. An impulse changes momentum; inertia alone cannot accelerate a body. Momentum and energy conversion require an interaction and an energy budget. Damping transfers motion energy to an environment."
field_of_study = "Kinematics and Momentum"
casters_notes = "Learn: Vector Reversal, Inertia Vault, Impact Prism, Momentum Anchor. Mana supplies fictional effects; capability tags restrict environmental manipulation."
