script = ExtResource("1_umba0")
spell_name = "Focal Point"
spell_id = "PHY-OP-003"
spell_icon = ExtResource("2_y7w47")
spell_flavour_text = "All of it. To one point. Nowhere left to scatter."
theory_desc = "Converging lens behaviour — parallel rays focus to a single point maximising energy density. Caster gathers ambient mana waves along a line and converges them through their conductor to a needle-point projectile. Extremely high damage, extremely narrow. Misses entirely if the target moves laterally — the beam does not track.
Synergy: Inertial Anchor first → target cannot move laterally → guaranteed full damage with no evasion window."
