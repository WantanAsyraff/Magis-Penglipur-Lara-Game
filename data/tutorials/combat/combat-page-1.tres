[resource]
script = ExtResource("1_b8h11")
page_title = "BASICS OF CONTROLS"
page_desc = "Welcome Spellcaster! This tutorial section will explain the basics of movement, spellcasting and navigation.

Keep in mind that this is all as I like to call it— \"A proof of concept\" so definitely keep that in mind!

To walk you use \"WASD\", the formal yk.

\"Shift\" is for dash, you have that too.

To interact with NPC, doors and any interactables in general is \"E\"."
page_image = ExtResource("1_5byxh")
metadata/_custom_type_script = "uid://bgh41gug308cv"
