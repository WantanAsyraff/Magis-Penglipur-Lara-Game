script = ExtResource("1_23gko")
spell_name = "Maxwell's Sortition"
spell_id = "PHY-001-NP"
spell_icon = ExtResource("2_fvirm")
spell_flavour_text = "e doesn't slow you down. He just decides which parts of you get to move."
theory_desc = "Maxwell's Demon thought experiment — a hypothetical entity that sorts fast and slow molecules, violating apparent entropy at an information cost. Caster acts as Maxwell's Demon over the opponent's mana particles, selectively slowing high-energy ones (suppressing offensive output) while accelerating low-energy ones into thermal noise (disrupting concentration). Net effect: spell potency degrades and cast times increase. Sustained concentration required or the sort collapses.
Synergy: Entropy Accelerate first widens particle energy distributions making selective targeting more precise."
