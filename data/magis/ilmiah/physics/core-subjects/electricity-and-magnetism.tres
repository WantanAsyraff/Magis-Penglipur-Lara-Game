[resource]
script = ExtResource("2_la2ka")
subject_name = "Electricity & Magnetism"
subject_icon = ExtResource("3_ais08")
subject_id = "PHY-001-EM"
subject_archetype = "Physical Sciences"
field_of_study = "The study of electric charge, current, fields, magnetic forces, and the unified electromagnetic interaction. Covers Coulomb's Law, Ohm's Law, and fundamental electromagnetism."
theoretical_foundation = "Electrical Discharge: charge differential between two points creates a conductive arc that follows the path of least resistance. A weakened mana aura IS that path — the arc finds it automatically.

Electromagnetism: magnetic fields exert forces on moving charges. A caster who magnetises a target's mana field relative to a fixed point can pull or lock them using opposing magnetic poles."
casters_notes = "Electricity rewards setup. These spells hit hardest against targets already weakened by other subjects — aura suppression from Thermodynamics makes the arc find its mark with almost no resistance. Know your combinations before you cast."
magis_archetype = "Ilmiah"
magis_comprehension = "Intermediate"
difficulty_level = 3
prerequisites = Array[String](["PHY-001-CM"])
contained_spells = Array[ExtResource("1_n1iss")]([ExtResource("2_3k25x"), ExtResource("3_8rtvt")])
metadata/_custom_type_script = "uid://b6vkafnios50y"
