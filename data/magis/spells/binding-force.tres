[resource]
script = ExtResource("1_rtf67")
spell_name = "Binding Force"
spell_id = "PHY-NP-002"
spell_icon = ExtResource("2_xpo3f")
spell_flavour_text = "The strongest force in the universe operates at the shortest range. He brought it closer."
theory_desc = "Strong nuclear force — the most powerful fundamental force, operating at extremely short range, binding protons and neutrons against electromagnetic repulsion. Caster internalises this as an extremely dense short-range mana barrier absorbing a fixed damage threshold before shattering. Unlike wave-based defences this is raw structural resistance — unaffected by Dampening Field logic. Breaks in one hit if incoming force exceeds the binding threshold.
Synergy: Binding Force absorbs the first Fission Strike hit — risk/reward in mirror matches."
spell_type = 1
spell_manifest = 2
magis_comprehension = "Advanced"
spell_incantation = Array[String](["down", "down", "left"])
upfront_cost = 32
cast_time = 1.0
is_self_cast = true
aoe_spell_radius = 1.5
