[resource]
script = ExtResource("2_wokby")
subject_name = "Thermodynamics I: Energy Transfer"
subject_icon = ExtResource("3_wokby")
subject_id = "PHY-001-TH"
subject_archetype = "Physical Sciences"
field_of_study = "The study of heat, energy transfer, and thermodynamic systems. Covers the First and Second Laws, entropy, conduction, convection, and thermal equilibrium."
theoretical_foundation = "First Law (Conservation of Energy): energy cannot be created or destroyed, only transferred or converted. Every spell costs something. There is no free energy.

Second Law (Entropy): systems naturally move toward disorder. Heat flows from hot to cold, never the reverse, without external work. A caster can exploit entropy — accelerating decay, dispersing energy — but cannot reverse it without exceptional mana cost.

Thermal Equilibrium: two systems in contact exchange energy until reaching the same temperature. The basis for drain and siphon spell logic — differential energy states, not magic tricks."
casters_notes = "Anyone can make fire. Understanding entropy and heat transfer is what separates a fire caster from someone who can selectively combust the moisture in an opponent's grip — making them drop their conductor without a single visible spark. Entropy is not chaos. It is direction."
magis_archetype = "Ilmiah"
difficulty_level = 3
prerequisites = Array[String](["PHY-001-CM"])
contained_spells = Array[ExtResource("1_sdt4v")]([ExtResource("2_haba6"), ExtResource("3_4qrq5"), ExtResource("4_77lxv")])
metadata/_custom_type_script = "uid://b6vkafnios50y"
