script = ExtResource("1_fk0o8")
spell_name = "Concussive Wave"
spell_id = "PHY-WP-003"
spell_icon = ExtResource("2_oufa4")
spell_flavour_text = "The medium does the work. He just gives it a reason."
theory_desc = "The medium does the work. He just gives it a reason.\"
theory_desc = \"\"\"Mechanical wave propagation through medium. Caster compresses mana at a point and releases omnidirectionally — ground, air, or solid medium carries the pressure wave outward. Damage falls off with distance from origin (inverse square law). Effective in enclosed spaces where the medium cannot dissipate the wave freely.
Synergy: Inertial Anchor roots a group first — rooted targets cannot exit the radius and take full damage with no falloff evasion."
