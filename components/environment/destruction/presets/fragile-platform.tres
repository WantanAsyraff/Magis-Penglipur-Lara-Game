[gd_resource type="Resource" script_class="DestructibleConfig" format=3]
[ext_resource type="Script" path="res://components/environment/destruction/resources/destructible-config.gd" id="config"]
[ext_resource type="Script" path="res://components/environment/destruction/resources/destructible-state-definition.gd" id="state"]
[ext_resource type="Script" path="res://components/environment/destruction/behaviors/destruction-behavior.gd" id="behavior"]
[ext_resource type="Resource" path="res://components/environment/destruction/materials/wood.tres" id="material"]

[sub_resource type="Resource" id="intact"]
script = ExtResource("state")
state_id = &"intact"
health_threshold_ratio = 1.0
modulate_color = Color(1, 1, 1, 1)
animation_name = &"idle"

[sub_resource type="Resource" id="damaged"]
script = ExtResource("state")
state_id = &"damaged"
health_threshold_ratio = 0.75
modulate_color = Color(0.9, 0.8, 0.65, 1)
animation_name = &"damaged"

[sub_resource type="Resource" id="critical"]
script = ExtResource("state")
state_id = &"critical"
health_threshold_ratio = 0.4
modulate_color = Color(1, 0.55, 0.38, 1)
animation_name = &"critical"

[sub_resource type="Resource" id="destroyed"]
script = ExtResource("state")
state_id = &"destroyed"
health_threshold_ratio = 0.0
modulate_color = Color(0.5, 0.5, 0.5, 1)
animation_name = &"destroyed"
collision_enabled = false
interaction_enabled = false

[resource]
script = ExtResource("config")
destructible_id = "fragile-platform"
display_name = "Fragile Platform"
max_health = 12.0
material = ExtResource("material")
states = Array[ExtResource("state")]([SubResource("intact"), SubResource("damaged"), SubResource("critical"), SubResource("destroyed")])
behaviors = Array[ExtResource("behavior")]([])
