[resource]
script = ExtResource("1_40nnp")
page_title = "Students & Errands"
page_desc = "Roaming around, you will encounter student with icons above their heads. They're nerds who are in need of some errands to do! You can complete these quests in order to level up, earn rewards and other materials.

However keep in mind, students come and go so you might not be able to do quests that you want in the moment but they will be back (Do some other quests in the meantime). You could call them back from the receptionist (Coming Soon)."
metadata/_custom_type_script = "uid://bgh41gug308cv"
