[resource]
script = ExtResource("1_cr2b3")
spell_name = "Pressure Surge"
spell_id = "PHY-FM-001"
spell_icon = ExtResource("3_kji37")
spell_flavour_text = "Pressure in a confined space always finds a way out. Today, that way is through you."
theory_desc = "Pascal's Law — pressure applied to a confined fluid transmits equally in all directions. Caster encapsulates the target briefly in a pressurised mana shell and detonates it inward. The explosion is internal — force radiates outward from inside the target's own aura space. Bypasses surface-level defensive spells including Dampening Field because the pressure originates inside the boundary.
Synergy: Magnetic Bind holds the target inside the compression shell long enough for full pressure build — increases explosive damage by ~40%."
spell_manifest = 1
magis_archetype = "Ilmiah"
magis_comprehension = "Intermediate"
spell_incantation = Array[String](["up", "left", "up", "right", "up"])
upfront_cost = 45
cast_time = 0.8
