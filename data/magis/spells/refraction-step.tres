[resource]
script = ExtResource("1_au58h")
spell_name = "Refraction Step"
spell_id = "PHY-OP-001"
spell_icon = ExtResource("2_mqeyv")
spell_colour = Color(0.9, 0.95, 1, 1)
spell_flavour_text = "He doesn't dodge. He bends at the boundary."
theory_desc = "Snell's Law of refraction — light changes direction when crossing medium boundaries at an angle. Caster treats two points in space as medium boundaries and bends their own trajectory to reposition at the refracted angle. Appears as a sharp angular dash — not a blink, not a straight line. Shallow angle = short redirect. Steep angle = sharp cut.
Synergy: Refraction Step into melee range → Third Law Impact. Angular approach makes impact direction hard to read."
spell_type = 8
spell_manifest = 3
magis_archetype = "Ilmiah"
magis_comprehension = "Intermediate"
spell_incantation = Array[String](["up", "left", "up"])
upfront_cost = 30
cast_time = 0.2
